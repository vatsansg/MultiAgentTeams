# Console login (single user)
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=change-me
FLASK_SECRET_KEY=change-me-too

# Anthropic / Managed Agents (same values as ../labs/.env)
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_DOCS_VAULT_ID=vlt_...
SLACK_VAULT_ID=vlt_...
SLACK_CHANNEL=#delivery
MODEL=claude-sonnet-5
MAX_ITERATIONS=2

# Optional overrides - normally left unset; pipeline.py reads these from
# the vault credentials automatically.
# GOOGLE_DOCS_MCP_URL=https://your-google-docs-mcp.example.com/mcp
# SLACK_MCP_URL=https://your-slack-mcp.example.com/mcp
